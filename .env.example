# Base URL of the SokoPlus backend docs API.
# In development this is optional — Vite proxies /api/docs to the local backend.
# In production set this to your deployed backend, e.g.:
#   VITE_DOCS_API_URL=https://sokoplus-backend.onrender.com/api/docs
VITE_DOCS_API_URL=http://localhost:5001/api/docs
